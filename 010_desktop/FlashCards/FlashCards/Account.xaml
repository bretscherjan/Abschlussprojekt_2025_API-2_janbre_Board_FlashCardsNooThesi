<Window x:Class="FlashCards.Account"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/favicon.ico"
        Title="Account Overview" Height="600" Width="800" Background="#2f2f2f">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" Cursor=""/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="Account Overview"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#dfaa30"
                   HorizontalAlignment="Center"
                   Margin="0,10"/>
        <Button Cursor="Hand" Content="Back"
                Width="80"
                Height="30"
                Margin="5"
                HorizontalAlignment="Right"
                Click="BackButton_Click"
                Background="#dfaa30"
                Foreground="White"/>

        <!-- Account Info Section -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="5" Margin="0,0,0,20">
            <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,20,0,0" HorizontalAlignment="Center" Width="400">

                <StackPanel>
                    <TextBlock Text="Username" 
                               Foreground="#dfaa30" 
                               FontSize="16" 
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="username"
                             Text="{Binding Username, Mode=OneWay}"
                             Background="#3a3a3a" 
                             Foreground="White" 
                             BorderBrush="#555" 
                             BorderThickness="1"
                             Height="40" 
                             Padding="10"
                             FontSize="14"
                             VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Email" 
                               Foreground="#dfaa30" 
                               FontSize="16" 
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="email"
                             Text="{Binding Email, Mode=OneWay}"
                             Background="#3a3a3a" 
                             Foreground="White" 
                             BorderBrush="#555" 
                             BorderThickness="1"
                             Height="40" 
                             Padding="10"
                             FontSize="14"
                             VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Passwort -->
                <StackPanel>
                    <TextBlock Text="Old password" 
                               Foreground="#dfaa30" 
                               FontSize="16" 
                               Margin="0,0,0,5"/>
                    <PasswordBox x:Name="PasswordBoxOld"
                                 Background="#3a3a3a" 
                                 Foreground="White" 
                                 BorderBrush="#555" 
                                 BorderThickness="1"
                                 Height="40" 
                                 Padding="10"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="New password" 
                               Foreground="#dfaa30" 
                               FontSize="16" 
                               Margin="0,0,0,5"/>
                    <PasswordBox x:Name="PasswordBoxNew1"
                                 Background="#3a3a3a" 
                                 Foreground="White" 
                                 BorderBrush="#555" 
                                 BorderThickness="1"
                                 Height="40" 
                                 Padding="10"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Confirm new password" 
                               Foreground="#dfaa30" 
                               FontSize="16" 
                               Margin="0,0,0,5"/>
                    <PasswordBox x:Name="PasswordBoxNew2"
                                 Background="#3a3a3a" 
                                 Foreground="White" 
                                 BorderBrush="#555" 
                                 BorderThickness="1"
                                 Height="40" 
                                 Padding="10"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="Save changes"
                            Width="140"
                            Background="#dfaa30" 
                            Foreground="#2f2f2f" 
                            FontSize="16" 
                            FontWeight="Bold"
                            Height="50" 
                            Cursor="Hand"
                            Click="SavePassword_Click"/>
                    <Button Content="Delete account"
                            Width="140"
                            Background="#aa3030"
                            Foreground="White"
                            FontSize="16" 
                            FontWeight="Bold"
                            Height="50" 
                            Cursor="Hand"
                            Click="DeleteAccountButton_Click"/>
                    <Button Content="Log Out"
                            Width="100"
                            Background="#666"
                            Foreground="White"
                            FontSize="16" 
                            FontWeight="Bold"
                            Height="50" 
                            Cursor="Hand"
                            Click="LogOutButton_Click"/>
                </StackPanel>
                <ComboBox Style="{StaticResource YellowComboBoxStyle}" Margin="40, 40, 40, 40"
                          ItemsSource="{Binding BenutzerNamenListe}"
                          SelectedItem="{Binding SelectedBenutzer, Mode=TwoWay}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
